# puerto del servidor (docker mapea 3006 → 3000)
PORT=3000

# ruta de la base de datos sqlite (relativa al cwd; docker usa /app/data/fantasy.db)
DATABASE_PATH=./data/fantasy.db

# token de refresco de fantasy marca (cookie refresh-token, jwt de larga duración).
# el x-auth por comunidad se renueva solo desde el _FG_cfg embebido en /feed.
FANTASY_REFRESH_TOKEN=

# desactiva los pollers para trabajar en local contra un snapshot de producción
DISABLE_POLLING=0

# oidc contra id.mier.info (login del dashboard)
OIDC_ISSUER=https://id.mier.info
OIDC_CLIENT_ID=
OIDC_CLIENT_SECRET=
OIDC_REDIRECT_URI=https://fantasy.mier.info/api/auth/callback

# correos autorizados, separados por comas. sin esto no entra nadie.
ALLOWED_EMAILS=


# url pública: la usan los metadatos oauth y el binding de audiencia del mcp
PUBLIC_BASE_URL=https://fantasy.mier.info

# trazas + logs a openobserve (platform/tooling/observability). vacío = sin export: las
# trazas siguen en proceso (trace id en los logs y en el header x-trace-id)
OTEL_EXPORTER_OTLP_ENDPOINT=
# Authorization=Basic <base64 de email:password del .env de openobserve>
OTEL_EXPORTER_OTLP_HEADERS=
# LOG_LEVEL=info          # debug|info|warn|error|silent
# LOG_FORMAT=pretty       # pretty ([scope] mensaje) | json (una línea por registro)
# DB_SLOW_QUERY_MS=100    # umbral del log de query lenta
# HTTP_SLOW_MS=1000       # umbral para que el access log suba a warn
