# puerto del servidor (docker mapea 3006 → 3000)
PORT=3000

# ruta de la base de datos sqlite (relativa al cwd; docker usa /app/data/fantasy.db)
DATABASE_PATH=./data/fantasy.db

# token de refresco de fantasy marca (cookie refresh-token, jwt de larga duración).
# el x-auth por comunidad se renueva solo desde el _FG_cfg embebido en /feed.
FANTASY_REFRESH_TOKEN=

# desactiva los pollers para trabajar en local contra un snapshot de producción
DISABLE_POLLING=0
