{
  "name": "@fantasy/api",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsup && mkdir -p dist/db && rm -rf dist/db/migrations && cp -r src/db/migrations dist/db/",
    "start": "node dist/index.js",
    "mcp:stdio": "tsx src/mcp/stdio.ts"
  },
  "dependencies": {
    "@fantasy/shared": "workspace:*",
    "@hono/node-server": "^1.14.0",
    "@modelcontextprotocol/sdk": "^1.0.0",
    "@opentelemetry/api": "^1.9.1",
    "@opentelemetry/api-logs": "^0.222.0",
    "@opentelemetry/exporter-logs-otlp-http": "^0.222.0",
    "@opentelemetry/exporter-trace-otlp-http": "^0.222.0",
    "@opentelemetry/resources": "^2.11.0",
    "@opentelemetry/sdk-logs": "^0.222.0",
    "@opentelemetry/sdk-trace-node": "^2.11.0",
    "@platform/auth": "workspace:*",
    "@platform/core-api": "workspace:*",
    "@platform/db": "workspace:*",
    "@platform/observability": "workspace:*",
    "@platform/oidc-rp": "workspace:*",
    "better-sqlite3": "^11.8.0",
    "dotenv": "^16.4.0",
    "drizzle-orm": "^0.38.0",
    "hono": "^4.7.0",
    "zod": "^4.6.6"
  },
  "devDependencies": {
    "@platform/config": "workspace:*",
    "@types/better-sqlite3": "^7.6.0",
    "@types/node": "^22.0.0",
    "tsup": "^8.3.0",
    "tsx": "^4.19.0",
    "typescript": "^5.7.0"
  },
  "bin": {
    "fantasy-mcp": "./dist/mcp/stdio.js"
  }
}
